{
  "expo": {
    "name": "Native Module Expo",
    "slug": "native-module-expo",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "nativemoduleexpo",
    "notification": {
      "icon": "./src/assets/notification_icon.png",
      "color": "#4A90E2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nativemoduleexpo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "We need your location to show your current position on the map."
      }
    },
    "android": {
      "icon": "./src/assets/icon.png",
      "package": "com.nativemoduleexpo"
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./src/assets/splash-icon.png"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID biometric data."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./src/assets/notification_sound.wav"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "55d2ede8-1c7c-4b9f-93c6-9024e01d0d11"
      }
    },
    "owner": "nolan-sotatek",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f28264cb-9638-474c-8a38-27e54b722d3b",
      "checkAutomatically": "NEVER"
    }
  }
}
